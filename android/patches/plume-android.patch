+            unsaved = 0;
+            lastSave = std::chrono::steady_clock::now();
+        }
+
+        // After a pipeline is created: once new ones have waited 5 seconds, save on a background
+        // thread (writing a few MB must not hold up whichever thread made the pipeline).
+        void created() {
