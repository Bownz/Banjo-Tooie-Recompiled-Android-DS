+    // Android: a Vulkan pipeline cache kept on disk (<BT_RENDER_CACHE_DIR>/pipelines.bin), so a
+    // pipeline the driver compiled once loads quickly in later sessions instead of being compiled
+    // again the first time each scene is seen. Saved a few seconds after new pipelines appear and
+    // when the device is released. The driver ignores data from another driver or GPU.
+    namespace AndroidPipelineCache {
+        std::mutex mutex;
+        VkPipelineCache cache = VK_NULL_HANDLE;
+        VkDevice owner = VK_NULL_HANDLE;
+        bool tried = false;
+        std::string path;
+        std::atomic<uint32_t> unsaved{ 0 };
+        std::chrono::steady_clock::time_point lastSave;
+
+        std::atomic<VkPipelineCache> readyCache{ VK_NULL_HANDLE };
+        std::atomic<VkDevice> readyOwner{ VK_NULL_HANDLE };
+        std::atomic<bool> saving{ false };
+
+        VkPipelineCache get(VkDevice device) {
+            if (readyOwner.load(std::memory_order_acquire) == device) {
+                return readyCache.load(std::memory_order_relaxed);   // the usual path: no lock
+            }
+            std::lock_guard<std::mutex> lock(mutex);
+            if (tried) {
+                return (owner == device) ? cache : VK_NULL_HANDLE;
+            }
+            tried = true;
+            const char *dir = std::getenv("BT_RENDER_CACHE_DIR");
+            if (dir == nullptr) {
+                return VK_NULL_HANDLE;
+            }
+            path = std::string(dir) + "/pipelines.bin";
+            std::vector<char> data;
+            {
+                std::ifstream f(path, std::ios::binary);
+                if (f) {
+                    data.assign(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());
+                }
+            }
+            VkPipelineCacheCreateInfo info = {};
+            info.sType = VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO;
+            info.initialDataSize = data.size();
+            info.pInitialData = data.empty() ? nullptr : data.data();
+            VkResult res = vkCreatePipelineCache(device, &info, nullptr, &cache);
+            if ((res != VK_SUCCESS) && !data.empty()) {
+                info.initialDataSize = 0;
+                info.pInitialData = nullptr;
+                res = vkCreatePipelineCache(device, &info, nullptr, &cache);
+            }
+            if (res != VK_SUCCESS) {
+                cache = VK_NULL_HANDLE;
+                return VK_NULL_HANDLE;
+            }
+            owner = device;
+            lastSave = std::chrono::steady_clock::now();
+            readyCache.store(cache, std::memory_order_relaxed);
+            readyOwner.store(device, std::memory_order_release);
+            fprintf(stdout, "Pipeline cache: %zu KB loaded from %s\n", data.size() / 1024, path.c_str());
+            fflush(stdout);
+            return cache;
+        }
+
+        void saveLocked() {
+            if ((cache == VK_NULL_HANDLE) || path.empty()) {
+                return;
+            }
+            size_t size = 0;
+            if ((vkGetPipelineCacheData(owner, cache, &size, nullptr) != VK_SUCCESS) || (size == 0)) {
+                return;
+            }
+            std::vector<char> data(size);
+            if (vkGetPipelineCacheData(owner, cache, &size, data.data()) != VK_SUCCESS) {
+                return;
+            }
+            const std::string tmp = path + ".tmp";
+            {
+                std::ofstream f(tmp, std::ios::binary | std::ios::trunc);
+                if (!f) {
+                    return;
+                }
+                f.write(data.data(), std::streamsize(size));
+                if (!f) {
+                    return;
+                }
+            }
+            std::rename(tmp.c_str(), path.c_str());
+            unsaved = 0;
+            lastSave = std::chrono::steady_clock::now();
+        }
+
+        // After a pipeline is created: once new ones have waited 5 seconds, save on a background
+        // thread (writing a few MB must not hold up whichever thread made the pipeline).
+        void created() {
+            unsaved++;
+            if (saving.load(std::memory_order_relaxed) || (readyOwner.load(std::memory_order_acquire) == VK_NULL_HANDLE)) {
+                return;
+            }
+            std::unique_lock<std::mutex> lock(mutex, std::try_to_lock);
+            if (!lock.owns_lock() || ((std::chrono::steady_clock::now() - lastSave) < std::chrono::seconds(5))) {
+                return;
+            }
+            lastSave = std::chrono::steady_clock::now();
+            saving = true;
+            std::thread([] {
+                std::lock_guard<std::mutex> saveLock(mutex);
+                saveLocked();
+                saving = false;
+            }).detach();
+        }
+
+        void release(VkDevice device) {
+            std::lock_guard<std::mutex> lock(mutex);
+            if ((cache == VK_NULL_HANDLE) || (owner != device)) {
+                return;
+            }
